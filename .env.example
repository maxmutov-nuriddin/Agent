# Nusxa ko'chirib .env nomi bilan saqlang. .env hech qachon git'ga tushmaydi.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Byudjet (USD) har provayder uchun. 5 dan 10 ga o'tish uchun faqat shu raqamni o'zgartiring.
BUDGET_USD_ANTHROPIC=5
BUDGET_USD_OPENAI=5
BUDGET_USD_GEMINI=5

# Bitta vazifa uchun maksimal sarf (USD), agentlar cheksiz aylanib ketmasligi uchun
MAX_TASK_USD=1.0
MAX_AGENTS=12
MAX_PARALLEL_TASKS=2
MAX_REVISIONS=1

# Lokal: SQLite. Keyinroq Supabase/Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///data/company.db
