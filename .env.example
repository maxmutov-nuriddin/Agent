# Nusxa ko'chirib .env nomi bilan saqlang. .env hech qachon git'ga tushmaydi.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Byudjet (USD) har provayder uchun. 5 dan 10 ga o'tish uchun faqat shu raqamni o'zgartiring.
BUDGET_USD_ANTHROPIC=5
BUDGET_USD_OPENAI=5
BUDGET_USD_GEMINI=5

# Bitta vazifa uchun maksimal sarf (USD), agentlar cheksiz aylanib ketmasligi uchun
MAX_TASK_USD=0.5
MAX_AGENTS=12
MAX_PARALLEL_TASKS=2
MAX_REVISIONS=1

# Lokal: SQLite. Keyinroq Supabase/Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///data/company.db

# Ixtiyoriy: veb-qidiruv uchun Brave Search API kaliti (bepul tarif bor). Bo'lmasa DuckDuckGo ishlatiladi (kamroq barqaror).
BRAVE_API_KEY=
# Kunlik hisobot vaqti (soat) va vaqt zonasi
REPORT_HOUR=9
REPORT_TZ=Asia/Tashkent
# Agent bir vazifada nechta asbob chaqiruvi qila oladi; buyruq vaqt chegarasi (soniya)
MAX_TOOL_TURNS=8
COMMAND_TIMEOUT=60
# Agentlar fayllari saqlanadigan papka
WORKSPACE_DIR=workspace

# Veb-panel (PWA). Kalitlar birinchi ishga tushirishda avtomatik yaratilib shu faylga yoziladi.
# Telefondan ochish uchun WEB_HOST=0.0.0.0 qiling (faqat ishonchli WiFi'da yoki Tailscale/Tunnel orqali!).
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_TOKEN=
WIDGET_TOKEN=
# Ixtiyoriy: tashqaridan ochiladigan manzil (Tailscale/Cloudflare Tunnel). /web buyrug'i shuni yuboradi.
WEB_PUBLIC_URL=

# Asosiy AI: auto (eng arzoni) | anthropic | gemini | openai. Panelda (Hisob) yoki Telegramda (/ai) ham o'zgartiriladi.
# Kaliti yo'q provayder ishlatilmaydi: faqat bitta kalit bo'lsa faqat o'sha ishlaydi.
PRIMARY_PROVIDER=auto
# Ixtiyoriy, daraja bo'yicha: masalan oddiy ishlar Gemini'da, qiyinlari Claude'da
PROVIDER_BY_TIER=

# ===== Xarita / joylashuv (ixtiyoriy; bo'lmasa bepul OpenStreetMap ishlatiladi) =====
# Google Maps Platform kaliti: tirbandlikni hisobga olgan yo'l vaqti, jamoat transporti, aniqroq joy qidiruv
GOOGLE_MAPS_API_KEY=

# ===== Shaxsiy Telegram akkaunt (bot emas: sizning akkauntingiz) =====
# 1) https://my.telegram.org -> API development tools: TG_API_ID va TG_API_HASH oling
# 2) pip install -r requirements.txt, so'ng: python -m aicompany tglogin  (bir marta: telefon + kod)
TG_API_ID=
TG_API_HASH=
# read = faqat o'qish (xavfsiz boshlanish); write = xabar yuborish ham (HAR xabar sizning tasdig'ingiz bilan)
TG_MODE=read
# Ixtiyoriy: xabar yuborish mumkin bo'lgan kontaktlar (@username yoki ism, vergul bilan). Bo'sh = hammasi (baribir tasdiqlanadi)
TG_ALLOWED=
TG_MAX_SENDS_PER_HOUR=10
TG_SESSION=data/tg
# Kod so'rash "ulanmoqda" da osilib qolsa: Telegram ilovangizdagi proksi havolasi (tg://proxy?server=..&port=..&secret=..)
# yoki socks5://host:port. Panelda ham kiritsa bo'ladi.
TG_PROXY=
# Shaxsiy yozishmalar matni faqat shu AI'larga yuboriladi (masalan: anthropic). Bo'sh = hamma ulangan AI'ga.
# Bepul Gemini kalitiga shaxsiy yozishmalarni yubormaslik uchun shuni to'ldirish tavsiya etiladi.
PRIVATE_PROVIDERS=

# --- Ovozni matnga aylantirish (ixtiyoriy; bo'lmasa Gemini ishlatiladi) ---
# Google Cloud Speech-to-Text API kaliti (oyiga ~60 daqiqa bepul)
GOOGLE_STT_KEY=
# Microsoft Azure Speech (oyiga ~5 soat bepul)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Serverdagi Whisper modeli: tiny / base / small / off (faster-whisper o'rnatilgan bo'lsa)
WHISPER_MODEL=small
# Bepul limitlar (daqiqa/oy) — o'zgartirish shart emas
STT_GOOGLE_FREE_MIN=60
STT_AZURE_FREE_MIN=300

# --- Bepul AI (OpenRouter, ixtiyoriy): faqat Sozlamalarda yoqilsa, oddiy fon ishlari (kuzatuvlar) uchun ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
